{
  "name": "@getdashfy/ext-market-live",
  "version": "0.2.2",
  "description": "Market Live extension for Dashfy - Real-time prices from the Pyth Network oracle",
  "keywords": [
    "dashfy",
    "dashboard",
    "widgets",
    "extension",
    "market",
    "live",
    "pyth",
    "solana",
    "oracle",
    "commodities",
    "crypto",
    "equities",
    "forex",
    "rates"
  ],
  "homepage": "https://github.com/dashfy/dashfy-ext-market-live#readme",
  "bugs": {
    "url": "https://github.com/dashfy/dashfy-ext-market-live/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:dashfy/dashfy-ext-market-live.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Breno Polanski",
    "email": "breno@dashfy.dev",
    "url": "https://github.com/brenopolanski"
  },
  "type": "module",
  "dashfy": {
    "id": "market-live",
    "title": "Market Live",
    "categories": [
      "finance"
    ],
    "docs": "Browse feed IDs at https://pyth.network/developers/price-feed-ids",
    "widgets": [
      "PriceLive",
      "TableLive"
    ],
    "starter": [
      {
        "widget": "PriceLive",
        "feedId": "crypto.BTC_USD",
        "showChart": true
      }
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsup",
    "changeset": "changeset",
    "changeset:publish": "changeset publish",
    "changeset:version": "changeset version",
    "check:all": "pnpm check:fix && pnpm check:circular",
    "check:circular": "madge --circular --extensions ts,tsx src/ --ts-config tsconfig.json",
    "check:fix": "pnpm format && pnpm lint:fix && pnpm typecheck",
    "clean": "rm -rf dist node_modules",
    "dev": "tsup --watch",
    "format": "pnpm prettier --write",
    "format:check": "pnpm prettier --check",
    "generate:feeds": "tsx src/scripts/generate-pyth-feeds.ts",
    "lint": "eslint .",
    "lint-staged": "lint-staged",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,css,json,md}\"",
    "sync:dashfy": "node scripts/sync-dashfy-deps.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm check:all && pnpm test && pnpm build"
  },
  "dependencies": {
    "@getdashfy/utils": "^0.1.1",
    "@pythnetwork/client": "^2.22.0",
    "@solana/web3.js": "^1.98.4",
    "liveline": "^0.0.7"
  },
  "peerDependencies": {
    "@getdashfy/ui": "^0.3.1",
    "lucide-react": ">=0.454.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.1",
    "@eslint/js": "^9.17.0",
    "@getdashfy/ui": "^0.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.8.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.13.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "lucide-react": "^0.555.0",
    "madge": "^8.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.4"
  }
}
